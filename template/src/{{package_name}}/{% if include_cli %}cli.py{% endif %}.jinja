"""Command-line interface for {{ project_name }}."""

import typer

from {{ package_name }} import __version__{% if include_example %}, hello{% endif %}

app = typer.Typer(help="{{ description }}", no_args_is_help=True)
{%- if include_example %}


@app.command()
def greet(name: str = "world") -> None:
    """Print a greeting."""
    typer.echo(hello(name))
{%- else %}


@app.callback()
def main() -> None:
    """Keep subcommands even while there is only one."""
{%- endif %}


@app.command()
def version() -> None:
    """Print the installed version."""
    typer.echo(__version__)
