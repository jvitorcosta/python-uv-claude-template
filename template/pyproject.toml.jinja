[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
{%- if author_email %}
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
{%- else %}
authors = [{ name = "{{ author_name }}" }]
{%- endif %}
{%- if license == "MIT" %}
license = "MIT"
license-files = ["LICENSE"]
{%- endif %}
dependencies = [
{%- if include_data_science %}
    "numpy>=2.2",
    "pandas>=2.3",
    "scikit-learn>=1.7",
{%- endif %}
{%- if include_cli %}
    "typer>=0.16",
{%- endif %}
]

{%- if include_cli %}

[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:app"
{%- endif %}

[build-system]
requires = ["uv_build>=0.9,<1"]
build-backend = "uv_build"

[dependency-groups]
dev = [
{%- if include_data_science %}
    "ipykernel>=6.30",
{%- endif %}
    "mypy>=1.18",
{%- if include_data_science %}
    "pandas-stubs>=2.3",
{%- endif %}
    "pre-commit>=4.3",
    "pytest>=8.4",
    "pytest-cov>=7.0",
    "ruff>=0.14",
]

# ---------------------------------------------------------------- ruff
[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]
{%- if include_data_science %}
extend-exclude = ["notebooks"]  # exploration only; the pipeline lives in src/
{%- endif %}

[tool.ruff.lint]
select = [
    "E", "W",   # pycodestyle
    "F",        # pyflakes
    "I",        # isort
    "B",        # bugbear
    "UP",       # pyupgrade
    "SIM",      # simplify
    "RUF",      # ruff-specific
    "N",        # pep8-naming
    "PTH",      # use pathlib
    "S",        # bandit (security)
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]  # assert is fine in tests

# ---------------------------------------------------------------- mypy
[tool.mypy]
python_version = "{{ python_version }}"
strict = true
files = ["src", "tests"]
{%- if include_data_science %}

[[tool.mypy.overrides]]
# No type stubs published; add other untyped libraries here (lightgbm.*, xgboost.*, shap.*).
module = ["sklearn.*"]
ignore_missing_imports = true
{%- endif %}

# ---------------------------------------------------------------- pytest
[tool.pytest.ini_options]
addopts = ["-ra", "--strict-markers", "--strict-config"]
testpaths = ["tests"]

[tool.coverage.run]
source = ["{{ package_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
skip_covered = true
fail_under = 80
